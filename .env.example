# AquaStar 5000 developer settings. Copy to .env (development: project root;
# packaged app: the user data folder). Everything is optional; a missing .env
# is fine. User preferences (units, tray, backups...) live in the app's Settings.

# Minimum log level written to the log file: INFO, WARN or ERROR.
LOG_LEVEL=INFO

# Open DevTools on start (development only; DevTools are always disabled in
# packaged builds). `npm run dev` also turns this on.
OPEN_DEVTOOLS=false
